rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and settings
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Historical farm advisory sessions and recommendations
    match /users/{userId}/sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Soil test records
    match /users/{userId}/soil_records/{recordId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Agronomic reference data (read-only for authenticated users)
    match /agronomic_references/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Read-only from clients; managed via admin scripts
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
